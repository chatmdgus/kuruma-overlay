{
  "name": "kuruma-overlay",
  "version": "0.7.16",
  "private": true,
  "description": "디스코드 클라이언트 없이 채팅·음성 참여자를 화면 오버레이로 보는 앱",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "koffi": "^2.9.0",
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "dev.kuruma.overlay",
    "productName": "Kuruma Overlay",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/chatmdgus/kuruma-downloads/releases/download/overlay-latest"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kuruma Overlay",
      "artifactName": "KurumaOverlay-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js"
  }
}
